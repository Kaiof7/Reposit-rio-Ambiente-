# Copy to the ignored .env.local. Never put secrets in NEXT_PUBLIC_* variables.
# Seller WhatsApp number, digits only: 55 + DDD + number (e.g. 55DDNNNNNNNNN).
# Set it in Vercel (Settings > Environment Variables); never commit the real one.
# Next inlines NEXT_PUBLIC_* at build time: changing it requires a new build.
# Empty or invalid: the summary asks the customer to copy the message instead.
NEXT_PUBLIC_WHATSAPP_NUMBER=
LOG_LEVEL=info
# Postgres for the seller panel (Vercel Storage > Neon sets both). Empty: the
# store shows the catalog defaults from code and the panel cannot save.
DATABASE_URL=
# Optional direct connection, used for migrations when the provider requires it.
DATABASE_URL_UNPOOLED=
# Login for /painel: the seller e-mail and a password of at least 12
# characters. Set both in Vercel, never commit real values. Either empty:
# the panel stays closed.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Order copy by e-mail (Resend, free plan). Empty RESEND_API_KEY: orders go
# only through WhatsApp. ORDER_EMAIL_TO defaults to ADMIN_EMAIL. Without a
# verified domain, keep the default sender: Resend then delivers only to the
# e-mail of the Resend account.
RESEND_API_KEY=
ORDER_EMAIL_TO=
ORDER_EMAIL_FROM=
