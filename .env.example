# Copy to the ignored .env.local. Never put secrets in NEXT_PUBLIC_* variables.
# Seller WhatsApp number, digits only: 55 + DDD + number (e.g. 55DDNNNNNNNNN).
# Public by design: it goes in the wa.me link sent to the browser.
# Next inlines NEXT_PUBLIC_* at build time: changing it requires a new build.
# Empty or invalid: the summary asks the customer to copy the message instead.
NEXT_PUBLIC_WHATSAPP_NUMBER=
LOG_LEVEL=info
