# Copy to the ignored .env.local. Never put secrets in NEXT_PUBLIC_* variables.
# Optional: overrides the seller WhatsApp number versioned in
# src/lib/public-env.ts. Digits only: 55 + DDD + number (e.g. 55DDNNNNNNNNN).
# Next inlines NEXT_PUBLIC_* at build time: changing it requires a new build.
NEXT_PUBLIC_WHATSAPP_NUMBER=
LOG_LEVEL=info
